    <!-- Realistic ambulance mesh — Drivable via /model/ambulance/cmd_vel -->
    <!-- Spawn en (60, 0) sobre road ring, yaw=π/2 → body +X = world +Y -->
    <!-- → tangente CCW al círculo de R=60m centrado en origen. -->
    <include>
      <uri>model://ambulance_mesh</uri>
      <name>ambulance</name>
      <pose>60 0 1.2 0 0 1.5708</pose>
    </include>

    <!-- F450-style quad based on Iris, with forward camera + depth (ZED stand-in) -->
    <include>
      <uri>model://iris_with_camera</uri>
      <pose>0 0 0.195 0 0 0</pose>
    </include>

  </world>
</sdf>
