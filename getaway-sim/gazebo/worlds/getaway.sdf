        <visual name="seg_06"><pose>-42.43  42.43 0.01 0 0 3.9270</pose><geometry><box><size>25 5 0.02</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
        <visual name="seg_07"><pose>-55.43  22.96 0.01 0 0 4.3197</pose><geometry><box><size>25 5 0.02</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
