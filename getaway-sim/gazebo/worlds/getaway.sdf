      </link>
    </model>

    <!-- Plaza de despegue: parche de pavimento bajo el dron -->
    <model name="launch_pad">
      <static>true</static>
      <link name="link">
        <visual name="v">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>6 6 0.01</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

