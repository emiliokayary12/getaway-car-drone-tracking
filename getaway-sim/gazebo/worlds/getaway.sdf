        <visual name="seg_10"><pose>-42.43 -42.43 0.01 0 0 5.4978</pose><geometry><box><size>25 5 0.02</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
        <visual name="seg_11"><pose>-22.96 -55.43 0.01 0 0 5.8905</pose><geometry><box><size>25 5 0.02</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
        <visual name="seg_12"><pose>  0.00 -60.00 0.01 0 0 0.0000</pose><geometry><box><size>25 5 0.02</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
        <visual name="seg_13"><pose> 22.96 -55.43 0.01 0 0 0.3927</pose><geometry><box><size>25 5 0.02</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
        <visual name="seg_14"><pose> 42.43 -42.43 0.01 0 0 0.7854</pose><geometry><box><size>25 5 0.02</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
