FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/Mexico_City
ENV LANG=en_US.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg2 lsb-release ca-certificates locales sudo tzdata software-properties-common \
    git wget build-essential cmake python3-pip python3-dev \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ── ROS 2 Humble ───────────────────────────────────────────────
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg \
 && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
    http://packages.ros.org/ros2/ubuntu jammy main" \
    > /etc/apt/sources.list.d/ros2.list

# ── Gazebo Harmonic (LTS) ──────────────────────────────────────
RUN curl https://packages.osrfoundation.org/gazebo.gpg --output /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
 && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] \
    http://packages.osrfoundation.org/gazebo/ubuntu-stable jammy main" \
    > /etc/apt/sources.list.d/gazebo-stable.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-ros-base ros-humble-cv-bridge ros-humble-image-transport \
    ros-humble-sensor-msgs ros-humble-geometry-msgs ros-humble-tf2-ros \
    python3-colcon-common-extensions python3-rosdep python3-vcstool \
    gz-harmonic ros-humble-ros-gzharmonic \
    libgz-sim8-dev rapidjson-dev libopencv-dev \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    libgl1 libglx-mesa0 libegl1 libglvnd0 libglu1-mesa \
    libgl1-mesa-dri mesa-utils \
    xvfb xauth x11-utils \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init || true && rosdep update

# ── ardupilot_gazebo plugin ────────────────────────────────────
RUN mkdir -p /root/gz_ws/src \
 && git clone --depth 1 https://github.com/ArduPilot/ardupilot_gazebo /root/gz_ws/src/ardupilot_gazebo
RUN cd /root/gz_ws/src/ardupilot_gazebo && mkdir build && cd build \
 && cmake .. -DCMAKE_BUILD_TYPE=RelWithDebInfo \
 && make -j$(nproc) \
 && mkdir -p /root/gz_ws/install/ardupilot_gazebo/lib \
 && cp *.so /root/gz_ws/install/ardupilot_gazebo/lib/

# ── Python: visión + MAVLink ───────────────────────────────────
RUN pip3 install --no-cache-dir \
    torch==2.3.1 torchvision==0.18.1 \
    --index-url https://download.pytorch.org/whl/cu121

RUN pip3 install --no-cache-dir \
    pymavlink MAVProxy \
    ultralytics==8.3.40 \
    opencv-python==4.10.0.84 \
    numpy==1.26.4 \
    norfair==2.2.0 filterpy==1.4.5 \
    empy==3.3.4 catkin_pkg lark

ENV GZ_VERSION=harmonic
ENV ROS_DISTRO=humble
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc

WORKDIR /sim
CMD ["bash"]
